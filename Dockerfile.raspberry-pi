FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-venv \
    ros-humble-cv-bridge \
    ros-humble-joy \
    ros-humble-teleop-twist-joy \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/rose-ground-station

COPY requirements.txt /tmp/rose-ground-station-requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/rose-ground-station-requirements.txt

CMD ["/workspace/rose-ground-station/scripts/raspberry-pi-docker-entrypoint.sh"]
