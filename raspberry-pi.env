# RoSE Ground Station Raspberry Pi environment
# Copy to /etc/rose-ground-station.env on the Pi and edit values for your network.

# Ground station web server
GS_PORT=8000

# ROS 2 network discovery
# Must match the rover and any other ROS 2 machines.
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0

# Optional: set a fixed ROS middleware if the rover uses one explicitly.
# Leave commented unless you know the rover is pinned to this RMW.
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional rover workspace overlay containing custom messages, for example
# gnc_interfaces/SparkMotorTelemetry. The launch script sources this if present.
URC_ROS_WS=/home/pi/urc_2026

# Rover camera service discovery is automatic by default.
# The ground station first uses any rover IP published on ROS, then tries:
#   http://rover.local:8765
#   http://rose-rover.local:8765
#   http://urc-rover.local:8765
# If your rover uses a different hostname, uncomment and edit this.
# GS_ROVER_CAMERA_SERVICE_URLS=http://rover.local:8765,http://rose-rover.local:8765,http://urc-rover.local:8765
# GS_ROVER_CAMERA_SERVICE_PORT=8765

# Optional camera overrides. Bitrate values are kilobits per second (kbps).
# GS_CAMERA_BITRATE is the per-stream maximum used when one stream is active.
# GS_CAMERA_MIN_BITRATE is a preferred per-stream floor; if too many cameras
# are active to fit that floor under GS_CAMERA_MAX_TOTAL_BITRATE, the total
# cap wins and each stream is reduced below the floor to preserve rover control.
# GS_CAMERA_MAX_TOTAL_BITRATE is the hard global cap for all active camera
# streams combined. The software default is 1600. Set 0 to disable the cap;
# field use should keep this set and nonzero.
# Example: max=800, min=250, total=1600 means:
#   1 active camera  -> up to 800 kbps
#   2 active cameras -> up to 800 kbps each
#   4 active cameras -> up to 400 kbps each
#   8 active cameras -> up to 200 kbps each, below min because total cap wins
# GS_CAMERA_SOURCE=udp
# GS_CAMERA_UDP_PORTS=5000,5001,5002,5003,5004,5005,5006,5007
# GS_CAMERA_MAX_FPS=15
# GS_CAMERA_MIN_FPS=5
# GS_CAMERA_MAX_WIDTH=4096
# GS_CAMERA_MAX_HEIGHT=2160
# GS_CAMERA_MIN_WIDTH=320
# GS_CAMERA_MIN_HEIGHT=240
# GS_CAMERA_BITRATE=800
# GS_CAMERA_MIN_BITRATE=250
# GS_CAMERA_MAX_TOTAL_BITRATE=1600
# Keep the UDP receive buffer small enough that congestion drops stale video
# instead of letting seconds of old frames queue up. Units are bytes.
# GS_CAMERA_UDP_BUFFER_SIZE=65536
# Rocket radio IPs edited in the Network tab persist here by default. Keep this
# outside tracked files so git pulls and container restarts do not reset it.
# GS_NETWORK_CONFIG_PATH=data/local/network_config.json
# Browser MJPEG fanout from the ground station. These do not change rover radio
# bitrate, but lower values reduce Raspberry Pi CPU and browser-side latency.
# GS_CAMERA_BROWSER_FPS=15
# GS_CAMERA_JPEG_QUALITY=70
# Camera names edited in the Cameras tab persist here by default.
# GS_CAMERA_LABELS_PATH=data/camera_labels.json

# Controller paths.
# Prefer stable paths from: ls -l /dev/input/by-id/
DRIVE_CONTROLLER=/dev/input/js0
ARM_CONTROLLER=/dev/input/js1

# Controller ROS topics.
DRIVE_JOY_TOPIC=/drive/joy
ARM_JOY_TOPIC=/arm/joy
